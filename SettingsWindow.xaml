<Window x:Class="HexaDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HexaDock Settings" Width="500" Height="650" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#0B1217" Foreground="#EAFBFF">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="SETTINGS" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Simple, local, and private" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
        <Border Background="#111C22" BorderBrush="#203B45" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
          <StackPanel>
            <CheckBox x:Name="StartupToggle" Content="Start HexaDock when I sign in" FontSize="14" Margin="0,0,0,14" />
            <CheckBox x:Name="HideIconsToggle" Content="Hide Desktop icons while HexaDock is running" FontSize="14" Margin="0,0,0,10" />
            <TextBlock Text="Global shortcut: Ctrl + Alt + Space" Foreground="#66838C" FontSize="11" />
          </StackPanel>
        </Border>

        <Border Background="#111C22" BorderBrush="#203B45" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="INDEXED LOCATIONS" Foreground="#63DDEB" FontSize="11" />
            <ListBox x:Name="SourcesList" Grid.Row="1" Height="78" Margin="0,8" Background="#0C151A" Foreground="#EAFBFF" BorderBrush="#203B45" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="ADD FOLDER" Click="AddSource_Click" Margin="0,0,8,0" />
              <Button Content="REMOVE" Click="RemoveSource_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Background="#111C22" BorderBrush="#203B45" BorderThickness="1" CornerRadius="10" Padding="16">
          <StackPanel>
            <CheckBox x:Name="PinToggle" Content="Protect HexaDock with a PIN" FontSize="14" Checked="PinToggle_Changed" Unchecked="PinToggle_Changed" />
            <TextBlock x:Name="PinStateText" Foreground="#63DDEB" Margin="0,8,0,0" />
            <Grid x:Name="PinFields" Margin="0,15,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="PIN" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" />
                <PasswordBox x:Name="PinBox" MaxLength="8" Padding="9,7" Background="#18242B" Foreground="#EAFBFF" BorderBrush="#2A4954" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock Text="CONFIRM PIN" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" />
                <PasswordBox x:Name="ConfirmPinBox" MaxLength="8" Padding="9,7" Background="#18242B" Foreground="#EAFBFF" BorderBrush="#2A4954" />
              </StackPanel>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,14,0,0">
                <TextBlock Text="RECOVERY QUESTION" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" />
                <TextBox x:Name="QuestionBox" />
              </StackPanel>
              <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0">
                <TextBlock Text="RECOVERY ANSWER" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,5" />
                <PasswordBox x:Name="AnswerBox" Padding="9,7" Background="#18242B" Foreground="#EAFBFF" BorderBrush="#2A4954" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="PIN and recovery data stay on this PC. Vault imports are encrypted copies; originals remain untouched."
                   Foreground="#66838C" FontSize="11" TextWrapping="Wrap" Margin="2,14" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="CANCEL" Click="Cancel_Click" Margin="0,0,9,0" />
      <Button Content="SAVE" Click="Save_Click" Background="#16404A" BorderBrush="#00E9FF" />
    </StackPanel>
  </Grid>
</Window>

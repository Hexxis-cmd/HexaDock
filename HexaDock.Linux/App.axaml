<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HexaDock.Linux.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Button">
      <Setter Property="Background" Value="#15262D" />
      <Setter Property="Foreground" Value="#DDFBFF" />
      <Setter Property="BorderBrush" Value="#2B5360" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#101A20" />
      <Setter Property="Foreground" Value="#EAFBFF" />
      <Setter Property="BorderBrush" Value="#294A55" />
      <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#101A20" />
      <Setter Property="Foreground" Value="#EAFBFF" />
      <Setter Property="BorderBrush" Value="#294A55" />
    </Style>
  </Application.Styles>
</Application>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HexaDock.Linux.SettingsWindow"
        Title="HexaDock Settings" Width="520" Height="540" MinWidth="460" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="#0B1217">
  <Grid Margin="26" RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <TextBlock Text="SETTINGS" FontSize="24" FontWeight="SemiBold" Foreground="#EAFBFF" />
      <TextBlock Text="Simple, local, and private" Foreground="#66838C" Margin="0,4,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="14">
      <Border Background="#111C22" BorderBrush="#203B45" BorderThickness="1" CornerRadius="10" Padding="16">
        <StackPanel>
          <CheckBox x:Name="StartupToggle" Content="Start HexaDock when I sign in" Foreground="#EAFBFF" FontSize="14" />
          <TextBlock Text="Shortcut: Ctrl + Alt + Space (X11/XWayland) or click the dock icon" Foreground="#66838C" FontSize="11" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <Border Background="#111C22" BorderBrush="#203B45" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Text="INDEXED LOCATIONS" Foreground="#63DDEB" FontSize="11" />
          <ListBox x:Name="SourcesList" Grid.Row="1" Height="160" Margin="0,8" Background="#0C151A" Foreground="#EAFBFF" BorderBrush="#203B45" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="ADD FOLDER" Click="AddSource_Click" />
            <Button Content="REMOVE" Click="RemoveSource_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="Files stay where they are. Vault copies use AES-GCM encryption; the local key and settings are restricted to your Linux user account."
                 Foreground="#66838C" FontSize="11" TextWrapping="Wrap" Margin="2,0" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="9" Margin="0,16,0,0">
      <Button Content="CANCEL" Click="Cancel_Click" />
      <Button Content="SAVE" Click="Save_Click" Background="#16404A" BorderBrush="#00E9FF" />
    </StackPanel>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HexaDock</AssemblyName>
    <RootNamespace>HexaDock</RootNamespace>
    <Version>1.0.0</Version>
    <Product>HexaDock</Product>
    <Description>A clean, searchable Windows Desktop overlay.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HexaDock.ico</ApplicationIcon>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\UserLogo.png" />
    <Resource Include="Assets\HexaDock.ico" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="HexaDock.Linux\**\*.cs" />
    <None Remove="HexaDock.Linux\**\*" />
  </ItemGroup>
</Project>

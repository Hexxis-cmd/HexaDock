<Window x:Class="HexaDock.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock HexaDock" Width="410" Height="310" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#0B1217" Foreground="#EAFBFF" ShowInTaskbar="False">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="UNLOCK HEXADOCK" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Your files stay exactly where they are." Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,22,0,18">
      <StackPanel x:Name="PinPanel">
        <TextBlock Text="PIN" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />
        <PasswordBox x:Name="PinBox" MaxLength="8" Padding="10,8" FontSize="16" KeyDown="PinBox_KeyDown"
                     Background="#18242B" Foreground="#EAFBFF" BorderBrush="#2A4954" />
        <Button Content="FORGOT PIN?" Click="Recovery_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#64DCE9" />
      </StackPanel>

      <StackPanel x:Name="RecoveryPanel" Visibility="Collapsed">
        <TextBlock Text="RECOVERY QUESTION" Foreground="{StaticResource Muted}" FontSize="11" />
        <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="15" Margin="0,6,0,13" />
        <PasswordBox x:Name="AnswerBox" Padding="10,8" Background="#18242B" Foreground="#EAFBFF" BorderBrush="#2A4954" />
        <Button Content="BACK TO PIN" Click="BackToPin_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#64DCE9" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="CANCEL" Click="Cancel_Click" Margin="0,0,9,0" />
      <Button x:Name="ActionButton" Content="UNLOCK" Click="Action_Click" Background="#16404A" BorderBrush="#00E9FF" />
    </StackPanel>
  </Grid>
</Window>
